# Linux Beautify owns the engine via its extension/autostart, not im-config.
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
export SDL_IM_MODULE=fcitx
export GTK_PATH="${XDG_DATA_HOME:-$HOME/.local/share}/gnome-shell/extensions/linux-beautify@local/resources/runtime/usr/lib/x86_64-linux-gnu/gtk-3.0:${XDG_DATA_HOME:-$HOME/.local/share}/gnome-shell/extensions/linux-beautify@local/resources/runtime/usr/lib/x86_64-linux-gnu/gtk-4.0${GTK_PATH:+:$GTK_PATH}"
export QT_PLUGIN_PATH="${XDG_DATA_HOME:-$HOME/.local/share}/gnome-shell/extensions/linux-beautify@local/resources/runtime/usr/lib/x86_64-linux-gnu/qt5/plugins:${XDG_DATA_HOME:-$HOME/.local/share}/gnome-shell/extensions/linux-beautify@local/resources/runtime/usr/lib/x86_64-linux-gnu/qt6/plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
export GTK_IM_MODULE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/fcitx5/linux-beautify-gtk3.immodules"
